# 이 프로젝트는 직접 배포해서 "자신의 봇"으로 운영하는 것을 전제로 한다.
# .env 로 복사한 뒤 값을 채운다:  cp .env.example .env

# ─── 데이터베이스 (필수) ───────────────────────────────
DB_HOST=localhost
DB_USER=lotto
DB_PASSWORD=your_secure_password
DB_NAME=lotto
DB_PORT=3306

# ─── Telegram Bot (필수) ──────────────────────────────
# @BotFather 에서 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 스케줄러 알림을 받을 대화방 ID
TELEGRAM_CHAT_ID=your_chat_id_here

# 봇 사용을 허용할 텔레그램 user_id (쉼표 구분). 비워두면 전원 차단된다.
# 자신의 user_id 는 @userinfobot 등으로 확인할 수 있다.
# 예: TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_ADMIN_IDS=

# ─── 동행복권 연동 (선택) ──────────────────────────────
# 본인 계정을 설정하면 텔레그램 안에서 예치금 조회와 로또6/45 구매가 활성화된다.
# ⚠️ 구매는 실제 예치금이 차감되는 결제다. 비워두면 해당 기능은 동작하지 않는다.
DHL_USERNAME=
DHL_PASSWORD=

# ─── 캐시 (선택) ──────────────────────────────────────
# 과거 당첨 조합 캐시 사용 여부와 TTL(초)
ENABLE_CACHE=true
CACHE_TTL=3600
